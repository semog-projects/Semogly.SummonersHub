<Project Sdk="Microsoft.NET.Sdk">

  <!-- Camada de infraestrutura: implementa as abstrações da Application (EF Core + PostgreSQL). -->

  <ItemGroup>
    <!-- Identity (AddIdentityApiEndpoints) vive no shared framework do ASP.NET Core -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Bestiário gerado por src/Tools/Semogly.SummonersHub.GameDataSync -->
    <EmbeddedResource Include="GameData\monsters.json" LogicalName="Semogly.SummonersHub.GameData.monsters.json" />
    <EmbeddedResource Include="GameData\dungeons.json" LogicalName="Semogly.SummonersHub.GameData.dungeons.json" />
    <EmbeddedResource Include="GameData\pve-teams.json" LogicalName="Semogly.SummonersHub.GameData.pve-teams.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Semogly.SummonersHub.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Semogly.SummonersHub.Application\Semogly.SummonersHub.Application.csproj" />
  </ItemGroup>

</Project>
